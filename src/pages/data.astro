---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostStringTable from '../components/PostStringTable.astro';
import { buildAddressSpace } from '../data/addressSpace';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('posts', ({ data }) => data.published)).sort((a, b) => a.data.title.localeCompare(b.data.title, 'en', { sensitivity: 'base' }));
const { postAllocations } = buildAddressSpace(posts, base);
---

<BaseLayout title="All posts — BomboBombone" description="All posts by Marco Paciaroni, listed alphabetically.">
  <main class="disassembly-app" id="debugger-content" tabindex="-1">
    <h1 class="sr-only">Published research posts</h1>
    <div class="disassembly-toolbar">
      <a class="disassembly-back" href={base} data-history-back aria-label="Back to memory map"><span class="disassembly-back-icon" aria-hidden="true"></span><span>BACK</span></a>
      <div class="disassembly-title"><strong>.DATA</strong><span>ALL POSTS</span></div>
      <span class="disassembly-count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
    </div>

    <PostStringTable posts={posts} allocations={postAllocations} tableId="data-table" resizeKey="data" />
  </main>
</BaseLayout>
