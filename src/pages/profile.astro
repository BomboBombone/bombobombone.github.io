---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profileSymbols } from '../data/profile';
import { buildAddressSpace, formatAddress } from '../data/addressSpace';

const base = import.meta.env.BASE_URL;
const posts = await getCollection('posts', ({ data }) => data.published);
const { profileAllocations } = buildAddressSpace(posts, base);
const rows = profileSymbols.map((symbol) => {
  const address = formatAddress(profileAllocations[symbol.key].address);
  return { ...symbol, address, label: `a${symbol.value.replace(/[^A-Za-z0-9]/g, '').slice(0, 24)}` };
});
---

<BaseLayout title="About me — BomboBombone" description="I'm Marco Paciaroni, a cybersecurity researcher specializing in Windows and iOS.">
  <main class="disassembly-app" id="debugger-content" tabindex="-1">
    <h1 class="sr-only">About Marco Paciaroni</h1>
    <div class="disassembly-toolbar">
      <a class="disassembly-back" href={base} data-history-back aria-label="Back to memory map"><span class="disassembly-back-icon" aria-hidden="true"></span><span>BACK</span></a>
      <div class="disassembly-title"><strong>.RDATA</strong><span>ABOUT ME</span></div>
      <span class="disassembly-count">{rows.length} symbols</span>
    </div>

    <div class="ida-view">
      <div class="ida-view-tabs">
        <span class="ida-view-tab is-active">Symbol view</span>
        <span class="ida-view-context">.rdata / strings</span>
      </div>
      <div class="ida-list" role="list" aria-label="Profile symbols">
        {rows.map((symbol) => (
          <div class="ida-row" role="listitem">
            <span class="ida-address">.rdata:{symbol.address}</span>
            <span class="ida-label">{symbol.label}</span>
            <span class="ida-directive">db</span>
            <span class="ida-value">&quot;{symbol.value}&quot;,0</span>
            {symbol.href ? (
              <a class="ida-comment" href={symbol.href} target="_blank" rel="noreferrer">; {symbol.info} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
            ) : (
              <span class="ida-comment">; {symbol.info}</span>
            )}
          </div>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
