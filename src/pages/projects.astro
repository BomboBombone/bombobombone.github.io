---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projectPointers } from '../data/projects';
import { buildAddressSpace, formatAddress } from '../data/addressSpace';

const base = import.meta.env.BASE_URL;
const posts = await getCollection('posts', ({ data }) => data.published);
const { projectAllocations } = buildAddressSpace(posts, base);
---

<BaseLayout title="My projects — BomboBombone" description="Marco Paciaroni's public projects on GitHub.">
  <main class="disassembly-app" id="debugger-content" tabindex="-1">
    <h1 class="sr-only">Project pointers</h1>
    <div class="disassembly-toolbar">
      <a class="disassembly-back" href={base} data-history-back aria-label="Back to memory map"><span class="disassembly-back-icon" aria-hidden="true"></span><span>BACK</span></a>
      <div class="disassembly-title"><strong>.PDATA</strong><span>MY PROJECTS</span></div>
      <span class="disassembly-count">{projectPointers.length} {projectPointers.length === 1 ? 'pointer' : 'pointers'}</span>
    </div>

    <div class="disassembly-table" id="pdata-table" data-resizable-table data-resize-key="pdata" role="table" aria-label="Project pointer table">
      <div class="disassembly-header" role="row">
        <span class="disassembly-column" role="columnheader">ADDRESS<button class="column-resizer" type="button" role="separator" aria-orientation="vertical" aria-label="Resize address column" aria-controls="pdata-table" aria-valuemin="112" aria-valuenow="160" aria-valuemax="800"></button></span>
        <span class="disassembly-column" role="columnheader">TYPE<button class="column-resizer" type="button" role="separator" aria-orientation="vertical" aria-label="Resize type column" aria-controls="pdata-table" aria-valuemin="56" aria-valuenow="70" aria-valuemax="800"></button></span>
        <span class="disassembly-column" role="columnheader">POINTER<button class="column-resizer" type="button" role="separator" aria-orientation="vertical" aria-label="Resize pointer column" aria-controls="pdata-table" aria-valuemin="180" aria-valuenow="240" aria-valuemax="800"></button></span>
        <span class="disassembly-column" role="columnheader">XREF</span>
      </div>
      <div class="disassembly-list">
        {projectPointers.length ? projectPointers.map((project) => (
          <div class="disassembly-row" role="row">
            <span class="disassembly-address" role="cell">{formatAddress(projectAllocations[project.key].address)}</span>
            <span class="disassembly-type" role="cell">DQ</span>
            <span class="disassembly-string" role="cell">{project.key} dq &quot;{project.value}&quot;</span>
            <span class="disassembly-xref" role="cell"><a class="disassembly-link" href={project.href} target="_blank" rel="noreferrer">{project.info} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></span>
          </div>
        )) : (
          <div role="row"><div class="disassembly-empty" role="cell" aria-colspan="4">NO PUBLIC PROJECTS YET</div></div>
        )}
      </div>
    </div>
  </main>
</BaseLayout>
